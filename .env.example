# Application
APP_NAME=Enterprise Incident Investigation Agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=incident_knowledge
VECTOR_SIZE=768

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# RAG configuration
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=60

# Incident dataset
INCIDENT_DATA_FILE=data/incidents/incidents.json


VECTOR_DB_PATH=./storage/qdrant
COLLECTION_NAME=enterprise_incidents

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

REQUIRE_HUMAN_APPROVAL=true

